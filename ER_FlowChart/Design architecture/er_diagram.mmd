erDiagram
    USER ||--o{ FARM : owns
    FARM ||--o{ CROP : contains
    CROP ||--o{ CROPSTAGE : "passes through"
    CROPSTAGE ||--o{ ACTIVITYTEMPLATE : defines
    CROP ||--o{ ACTIVITY : has
    ACTIVITYTEMPLATE ||--o{ ACTIVITY : generates
    CROP ||--o{ EXPENSE : has
    CROP ||--o{ PROBLEMREPORT : has
    CROP ||--o{ DIARY : has
    PROBLEMKNOWLEDGEBASE ||--o{ PROBLEMREPORT : "matched against"
    ACTIVITY ||--o{ NOTIFICATION : triggers

    USER {
        int user_id PK
        string full_name
        string phone
        string email
        string password_hash
        string role
    }
    FARM {
        int farm_id PK
        int user_id FK
        string location
        float land_size
        string soil_type
        boolean irrigation_available
    }
    CROP {
        int crop_id PK
        int farm_id FK
        string crop_type
        date planting_date
        int current_stage_id FK
        string status
    }
    CROPSTAGE {
        int stage_id PK
        string crop_type
        string stage_name
        int sequence_order
        int duration_days
    }
    ACTIVITYTEMPLATE {
        int template_id PK
        int stage_id FK
        string activity_name
        string description
        string priority
        boolean reminder_required
    }
    ACTIVITY {
        int activity_id PK
        int crop_id FK
        int template_id FK
        date scheduled_date
        string status
        date completed_date
    }
    NOTIFICATION {
        int notification_id PK
        int activity_id FK
        int user_id FK
        string message
        boolean is_read
        datetime sent_at
    }
    EXPENSE {
        int expense_id PK
        int crop_id FK
        string category
        float amount
        date spent_on
    }
    DIARY {
        int diary_id PK
        int crop_id FK
        date entry_date
        string notes
    }
    PROBLEMREPORT {
        int report_id PK
        int crop_id FK
        int kb_id FK
        string description
        string image_url
        string status
        datetime reported_at
    }
    PROBLEMKNOWLEDGEBASE {
        int kb_id PK
        string crop_type
        string problem_name
        string symptoms
        string possible_causes
        string recommended_actions
        string warning_signs
        string status
    }
