flowchart TD
    A["Register / Login"] --> B["Create Farm"]
    B --> C["Register Crop"]
    C --> D["Enter Crop Information"]
    D --> E["Generate Crop Plan"]
    E --> F["Determine Current Crop Stage"]
    F --> G["Generate Activities"]
    G --> H["Notify Farmer"]
    H --> I["View Today's Activities"]
    I --> J["Complete / Skip Activity"]
    J --> K["View Guidance"]
    K --> L["Record Expenses / Diary"]
    L --> M{"Crop problem observed?"}
    M -->|"Yes"| N["Report Crop Problem"]
    N --> O["Receive Problem Assistance"]
    O --> P["Continue Crop Lifecycle"]
    M -->|"No"| P
    P --> Q{"Final stage reached?"}
    Q -->|"No"| F
    Q -->|"Yes"| R["Harvest"]
    R --> S["Store Crop History"]
